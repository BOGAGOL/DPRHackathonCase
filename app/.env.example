MODE=protected
DATABASE_URL=
AUTH_DATABASE_URL=
ANALYST_DATABASE_URL=
AUDITOR_DATABASE_URL=
# Required: exact browser HTTPS origin, including port if used; no trailing slash.
# The local launcher supplies its random origin automatically.
APP_ORIGIN=
SESSION_TTL_SECONDS=900
TLS_CERT_FILE=
TLS_KEY_FILE=
OPENBAO_ADDR=https://127.0.0.1:8200
OPENBAO_TOKEN=
OPENBAO_CACERT=
DPR_CRYPTO_FACTORY=dprcrypto:public-v1
# Recovery only: exact name from a successful A+B restore report, MODE=protected.
DPR_RESTORED_DATABASE=
# Provisioning only; never pass trusted setup credentials to the runtime launcher.
APP_SETUP_DATABASE_URL=
DEMO_ASSIGNED_IDS=
