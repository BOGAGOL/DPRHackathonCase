# Contoh produksi. Sesuaikan path, kapasitas, sertifikat, dan benchmark.
listen_addresses = '10.10.20.15'
port = 5432
ssl = on
ssl_cert_file = '/run/secrets/postgres-server.crt'
ssl_key_file = '/run/secrets/postgres-server.key'
ssl_ca_file = '/run/secrets/postgres-ca.crt'
password_encryption = 'scram-sha-256'
shared_preload_libraries = 'pg_stat_statements,pgaudit'
compute_query_id = on
track_io_timing = on
track_wal_io_timing = on
logging_collector = on
log_destination = 'jsonlog'
log_line_prefix = '%m [%p] user=%u db=%d app=%a client=%r '
log_connections = on
log_disconnections = on
log_lock_waits = on

