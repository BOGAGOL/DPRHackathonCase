COMPOSE_PROJECT_NAME=leakproof

POSTGRES_IMAGE=postgres:18
POSTGRES_DB=leakproof
POSTGRES_ADMIN_USER=lab_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN
APP_DB_USER=app_runtime
APP_DB_PASSWORD=CHANGE_ME_APP
MIGRATOR_DB_USER=data_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR
EXPORTER_DB_USER=metrics_exporter
EXPORTER_DB_PASSWORD=CHANGE_ME_EXPORTER

OPENBAO_IMAGE=openbao/openbao:2.6
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN=CHANGE_ME_AFTER_INITIALIZATION
OPENBAO_KEY_NAME=customer-data

PROMETHEUS_IMAGE=prom/prometheus:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.17.0
GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA

LAB_TENANT_ID=11111111-1111-1111-1111-111111111111
AES_KEY_B64=CHANGE_ME_32_BYTE_BASE64_KEY
BLIND_INDEX_KEY_B64=CHANGE_ME_DIFFERENT_32_BYTE_BASE64_KEY

